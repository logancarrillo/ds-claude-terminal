STARTFONT 2.1
FONT -TakWolf-Fusion Pixel 10px Mono zh_Hans-Regular-R-Normal-Sans Serif-10-100-75-75-M-98-ISO10646-1
SIZE 10 75 75
FONTBOUNDINGBOX 10 10 0 -1
STARTPROPERTIES 24
FOUNDRY "TakWolf"
FAMILY_NAME "Fusion Pixel 10px Mono zh_Hans"
WEIGHT_NAME "Regular"
SLANT "R"
SETWIDTH_NAME "Normal"
ADD_STYLE_NAME "Sans Serif"
PIXEL_SIZE 10
POINT_SIZE 100
RESOLUTION_X 75
RESOLUTION_Y 75
SPACING "M"
AVERAGE_WIDTH 98
CHARSET_REGISTRY "ISO10646"
CHARSET_ENCODING "1"
DEFAULT_CHAR 65534
FONT_ASCENT 9
FONT_DESCENT 1
X_HEIGHT 5
CAP_HEIGHT 7
UNDERLINE_POSITION -1
UNDERLINE_THICKNESS 1
FONT_VERSION "2026.10.16"
COPYRIGHT "Copyright (c) 2022, TakWolf (https://takwolf.com)"
LICENSE "This Font Software is licensed under the SIL Open Font License, Version 1.1"
ENDPROPERTIES
